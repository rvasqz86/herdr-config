#!/usr/bin/env bash
# hq — spin up herdr workspaces for code and docs work.
#
#   hq code <dir> [label]   tab "agents": 2x2 claude omp / copilot cursor   tab "shell": two shells
#   hq docs <dir> [label]   tab "write":  claude | shell    tab "review": omp
#   hq new                  interactive picker (bound to ctrl+alt+n)
#
# Must run inside herdr (HERDR_ENV=1).
set -euo pipefail

die() { echo "hq: $*" >&2; exit 1; }
HQ_HOME=${HQ_HOME:-$HOME/.config/herdr}
ROLES_DIR=${ROLES_DIR:-$HQ_HOME/roles}

slug() {
  local s
  s=$(tr '[:upper:]' '[:lower:]' <<<"$1" | tr -c 'a-z0-9\n' '-' | sed 's/^[^a-z]*//; s/-\{2,\}/-/g' | cut -c1-20)
  s=${s%-}
  [ -n "$s" ] || s="p$(tr -dc '0-9' <<<"$1" | cut -c1-8)"
  printf '%s\n' "$s"
}

role_kind() {
  case $1 in
    manager|taskrev) echo claude ;;
    planner) echo omp ;;
    specrev) echo copilot ;;
    impl) echo cursor ;;
    *) return 1 ;;
  esac
}

role_file() {
  case $1 in
    manager) echo "$ROLES_DIR/manager.md" ;;
    planner) echo "$ROLES_DIR/planner.md" ;;
    specrev) echo "$ROLES_DIR/spec-review.md" ;;
    impl) echo "$ROLES_DIR/implementer.md" ;;
    taskrev) echo "$ROLES_DIR/task-review.md" ;;
    *) return 1 ;;
  esac
}

runtime_get() { # dir key -> value, empty if unset
  local f="$1/.hq/runtime"
  [ -f "$f" ] || return 0
  sed -n "s/^$2=//p" "$f" | sed 's/[[:space:]]*#.*$//; s/[[:space:]]*$//' | tail -n 1
}

current_branch() { git -C "$1" symbolic-ref --short -q HEAD || true; }

agent_flags() { # kind autonomy branch -> one flag per line
  [ "$2" = trusted ] && [[ $3 == hq/* ]] || return 0
  case $1 in
    claude) echo --dangerously-skip-permissions ;;
    omp) echo --auto-approve ;;
    copilot) echo --allow-all-tools ;;
    cursor) printf '%s\n' --force --trust ;;
  esac
}

size_bytes() { # 20M | 512K | 1G | 1000 | '' (default 20M) -> bytes
  local v=${1:-20M} n
  [[ $v =~ ^([0-9]+)([KkMmGg]?)$ ]] || return 1
  n=${BASH_REMATCH[1]}
  case ${BASH_REMATCH[2]} in
    [Kk]) n=$((n * 1024)) ;;
    [Mm]) n=$((n * 1024 * 1024)) ;;
    [Gg]) n=$((n * 1024 * 1024 * 1024)) ;;
  esac
  echo "$n"
}

# Start an agent; don't abort the layout if it hits a trust/login prompt.
start_agent() { # name kind pane
  if ! herdr agent start "$1" --kind "$2" --pane "$3" --timeout 60000 >/dev/null 2>&1; then
    echo "hq: $1 ($2) needs attention in its pane (trust prompt / login?)" >&2
  fi
}

split() { # pane direction cwd -> new pane id
  herdr pane split "$1" --direction "$2" --cwd "$3" --no-focus | jq -r '.result.pane.pane_id'
}

new_workspace() { # dir label -> "ws_id root_pane first_tab"
  local out
  out=$(herdr workspace create --cwd "$1" --label "$2" --no-focus)
  jq -r '[.result.workspace.workspace_id, .result.root_pane.pane_id, .result.tab.tab_id] | @tsv' <<<"$out"
}

new_tab() { # ws dir label -> root pane id
  herdr tab create --workspace "$1" --cwd "$2" --label "$3" --no-focus | jq -r '.result.root_pane.pane_id'
}

layout_code() { # dir label
  local dir=$1 label=$2 name ws root tab right below_left below_right shell
  name=$(slug "$label")
  read -r ws root tab < <(new_workspace "$dir" "$label")
  herdr tab rename "$tab" agents >/dev/null
  right=$(split "$root" right "$dir")
  below_left=$(split "$root" down "$dir")
  below_right=$(split "$right" down "$dir")
  start_agent "${name}-claude" claude "$root"
  start_agent "${name}-omp" omp "$right"
  start_agent "${name}-copilot" copilot "$below_left"
  start_agent "${name}-cursor" cursor "$below_right"
  shell=$(new_tab "$ws" "$dir" shell)
  split "$shell" down "$dir" >/dev/null
  herdr workspace focus "$ws" >/dev/null
}

layout_docs() { # dir label
  local dir=$1 label=$2 name ws root tab review
  name=$(slug "$label")
  read -r ws root tab < <(new_workspace "$dir" "$label")
  herdr tab rename "$tab" write >/dev/null
  split "$root" right "$dir" >/dev/null   # shell for vim / previews / git
  start_agent "${name}-writer" claude "$root"
  review=$(new_tab "$ws" "$dir" review)
  start_agent "${name}-review" omp "$review"
  herdr workspace focus "$ws" >/dev/null
}

run() { # kind dir [label]
  local kind=$1 dir label
  dir=$(realpath -e "${2:-.}" 2>/dev/null) || die "no such directory: ${2:-}"
  label=${3:-$(basename "$dir")}
  case $kind in
    code) layout_code "$dir" "$label" ;;
    docs) layout_docs "$dir" "$label" ;;
    *) die "unknown layout '$kind' (use code|docs)" ;;
  esac
}

main() {
  [ "${HERDR_ENV:-}" = 1 ] || die "not running inside herdr"
  command -v jq >/dev/null || die "jq is required"
  case ${1:-} in
  code|docs) run "$@" ;;
  new)
    read -rp "Layout [code/docs]: " kind
    read -erp "Directory: " -i "$HOME/development/" dir
    read -rp "Label [$(basename "${dir%/}")]: " label
    run "$kind" "${dir/#\~/$HOME}" ${label:+"$label"}
    ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
